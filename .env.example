APP_NAME="Uptown Restaurant & Café"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Must match the URL the site is actually served from. Image URLs and the QR
# code target are both built from this — a wrong value means broken photos and
# QR codes that point at the wrong host.
APP_URL=http://127.0.0.1:8000

# Framework default. The visitor-facing language is decided at runtime by the
# SetLocale middleware (?lang= → cookie → the Default language in the admin),
# and the admin panel is always English.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uptown_menu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Menu photos and branding uploads live on the public disk.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# File cache needs no extra table and is the safest default on shared hosting.
CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
